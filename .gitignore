# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.profraw
Build/                 # Xcode build output when the build location is project-relative (M3+ app target)
*.xcuserstate
xcuserdata/
.DS_Store

# CMake — out-of-source build dirs, disposable (build, build-san, ...)
native-tests/build*/
/build/

# VS Code CMake Tools — local editor config, keep out of the repo
.vscode/

# Vault data — never commit anything with real secrets
*.pfvault
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.hw
# ...except migration-fixture vaults, which are SYNTHETIC by rule (§13.4).
!Packages/PassFortKit/Tests/PassFortVaultTests/Fixtures/**/*.sqlite

# macOS Spotlight-exclusion marker VaultDatabase drops in the vault directory
.metadata_never_index

# Later milestones (Cloud/, Web/)
node_modules/
*.wasm
.azure/
Cloud/api/local.settings.json

# Claude — local-only by choice
.claude
CLAUDE.md