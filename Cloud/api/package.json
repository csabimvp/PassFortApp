{
  "name": "passfort-sync-api",
  "version": "1.0.0",
  "private": true,
  "description": "PassFort sync API -- Azure Functions v4 (docs/runbooks/m5-sync.md Part A.3)",
  "type": "module",
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "gen": "openapi-typescript ../openapi.yaml -o src/dto.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/functions": "4.16.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
